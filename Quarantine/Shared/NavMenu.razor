<div class="top-row shell-brand-row">
    <a class="shell-brand" href="">
        <img src="apple-touch-icon.png" alt="" class="shell-brand-logo" />
        <span>Chap App</span>
    </a>
    <button class="shell-toggler" aria-label="Toggle menu" @onclick="ToggleNavMenu">
        <span></span><span></span><span></span>
    </button>
</div>
<div class="@NavMenuCssClass shell-nav-wrap" @onclick="ToggleNavMenu">
    <nav class="shell-nav">
        <NavLink class="shell-link" href="" Match="NavLinkMatch.All">
            <span class="shell-icon" style="--tile: #475569;">🏠</span> Home
        </NavLink>
        <span class="shell-nav-label">Games</span>
        <NavLink class="shell-link" href="nfl-pickems/weeks">
            <span class="shell-icon" style="--tile: #0f766e;">🏈</span> NFL Pickems
        </NavLink>
        <NavLink class="shell-link" href="dots">
            <span class="shell-icon" style="--tile: #17503a;">⛳</span> Dot Game
        </NavLink>
        <NavLink class="shell-link" href="ridethebus">
            <span class="shell-icon" style="--tile: #b45309;">🚌</span> Ride The Bus
        </NavLink>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
