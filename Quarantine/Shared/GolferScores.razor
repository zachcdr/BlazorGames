@using Quarantine.Helpers
@using Quarantine.Models

@if (Group?.Golfers != null && Group.Golfers.Any())
{
    var holes = Group.Golfers.First().Holes;
    var pars = GetPars(holes);
    var hasPars = pars.Values.Any(p => p.HasValue);
    var showSplits = holes.Any(h => h.Id <= 9) && holes.Any(h => h.Id >= 10);
    var leaders = Group.Golfers
        .Select(g => new { Golfer = g, View = new GolferScoreView(g) })
        .OrderByDescending(x => x.View.TotalDots)
        .ThenBy(x => x.View.RoundScore)
        .ToList();
    var rank = 0;

    <div class="golf-card">
        <h2 class="golf-card-title">Leaderboard</h2>
        <div class="golf-leaders">
            @foreach (var leader in leaders)
            {
                rank++;
                var toPar = ToPar(leader.Golfer, pars);
                <div class="golf-leader @(rank == 1 && leader.View.TotalDots > 0 ? "is-first" : "")">
                    <span class="golf-rank">@rank</span>
                    <span class="golf-avatar">@GolfStyle.Initials(leader.View.Name)</span>
                    <span class="golf-leader-name">@leader.View.Name</span>
                    <span class="golf-leader-stat">
                        <b>@leader.View.RoundScore</b>
                        @if (toPar.HasValue)
                        {
                            <span class="golf-to-par @(toPar < 0 ? "is-under" : "")">@GolfStyle.ToPar(toPar.Value)</span>
                        }
                        else
                        {
                            <span>Strokes</span>
                        }
                    </span>
                    <span class="golf-leader-stat is-dots">
                        <b>@leader.View.TotalDots</b>
                        <span>Dots</span>
                    </span>
                </div>
            }
        </div>
    </div>

    <div class="golf-card">
        <h2 class="golf-card-title">Scorecard</h2>
        <div class="golf-scroll">
            <table class="golf-scorecard">
                <thead>
                    <tr>
                        <th class="golf-name-cell">Hole</th>
                        @foreach (Hole hole in holes)
                        {
                            var holeId = hole.Id;
                            <th class="is-link @(holeId == Group.CurrentHole ? "is-current" : "")" title="Go to hole @holeId"
                                @onclick="@((MouseEventArgs e) => GoToHole(holeId))">@holeId</th>
                            @if (showSplits && holeId == 9)
                            {
                                <th class="golf-sum">Out</th>
                            }
                        }
                        @if (showSplits)
                        {
                            <th class="golf-sum">In</th>
                        }
                        <th class="golf-sum">Tot</th>
                    </tr>
                </thead>
                <tbody>
                    @if (hasPars)
                    {
                        <tr class="golf-par-row">
                            <td class="golf-name-cell">Par</td>
                            @foreach (Hole hole in holes)
                            {
                                <td>@pars[hole.Id]</td>
                                @if (showSplits && hole.Id == 9)
                                {
                                    <td>@SumPar(pars, 1, 9)</td>
                                }
                            }
                            @if (showSplits)
                            {
                                <td>@SumPar(pars, 10, 18)</td>
                            }
                            <td>@SumPar(pars, 1, 18)</td>
                        </tr>
                    }
                    @foreach (Golfer golfer in Group.Golfers)
                    {
                        <tr>
                            <td class="golf-name-cell">@golfer.Name</td>
                            @foreach (Hole hole in golfer.Holes)
                            {
                                <td>
                                    @if (hole.Score > 0)
                                    {
                                        <span class="golf-score @GolfStyle.ScoreClass(hole.Score, pars.GetValueOrDefault(hole.Id))">@hole.Score</span>
                                    }
                                    else
                                    {
                                        <span class="golf-score golf-score-empty">·</span>
                                    }
                                </td>
                                @if (showSplits && hole.Id == 9)
                                {
                                    <td class="golf-sum">@SumScore(golfer, 1, 9)</td>
                                }
                            }
                            @if (showSplits)
                            {
                                <td class="golf-sum">@SumScore(golfer, 10, 18)</td>
                            }
                            <td class="golf-sum">@SumScore(golfer, 1, 18)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (hasPars)
        {
            <div class="golf-legend">
                <span><span class="golf-score is-eagle">3</span> Eagle</span>
                <span><span class="golf-score is-birdie">3</span> Birdie</span>
                <span><span class="golf-score is-bogey">5</span> Bogey</span>
                <span><span class="golf-score is-double">6</span> Double+</span>
            </div>
        }
    </div>

    <div class="golf-card">
        <h2 class="golf-card-title">Dots</h2>
        <div class="golf-scroll">
            <table class="golf-scorecard">
                <thead>
                    <tr>
                        <th class="golf-name-cell">Hole</th>
                        @foreach (Hole hole in holes)
                        {
                            <th>@hole.Id</th>
                        }
                        <th class="golf-sum">Tot</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Golfer golfer in Group.Golfers)
                    {
                        <tr>
                            <td class="golf-name-cell">@golfer.Name</td>
                            @foreach (Hole hole in golfer.Holes)
                            {
                                <td>
                                    @if (hole.Dots.Count > 0)
                                    {
                                        <span class="golf-dotcount" title="@string.Join(", ", hole.Dots.Select(d => GolfStyle.DotIcon(d)))">@hole.Dots.Count</span>
                                    }
                                    else
                                    {
                                        <span class="golf-score-empty">·</span>
                                    }
                                </td>
                            }
                            <td class="golf-sum">@golfer.Holes.Sum(h => h.Dots.Count)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public GolfGroup Group { get; set; }

    [Parameter]
    public EventCallback<HoleUpdate> HoleUpdate { get; set; }

    private Dictionary<int, int?> GetPars(List<Hole> holes)
    {
        Course course = Group.CourseName == null ? null : CourseSelection.SelectCourse(Group.CourseName);
        return holes.ToDictionary(h => h.Id, h => course?.CourseHoles.FirstOrDefault(c => c.Number == h.Id)?.Par);
    }

    private static string SumPar(Dictionary<int, int?> pars, int from, int to)
    {
        return pars.Where(p => p.Key >= from && p.Key <= to).Sum(p => p.Value ?? 0).ToString();
    }

    private static string SumScore(Golfer golfer, int from, int to)
    {
        var total = golfer.Holes.Where(h => h.Id >= from && h.Id <= to).Sum(h => h.Score);
        return total == 0 ? "–" : total.ToString();
    }

    /// <summary>Strokes relative to par over the holes this golfer has played so far.</summary>
    private static int? ToPar(Golfer golfer, Dictionary<int, int?> pars)
    {
        var played = golfer.Holes.Where(h => h.Score > 0 && pars.GetValueOrDefault(h.Id).HasValue).ToList();
        if (!played.Any())
        {
            return null;
        }
        return played.Sum(h => h.Score - pars[h.Id].Value);
    }

    private async Task GoToHole(int currentHole)
    {
        await PerformUpdate(currentHole);
    }

    private async Task PerformUpdate(int currentHole)
    {
        Group.Golfers.ForEach(delegate(Golfer g)
        {
            g.IsVisible = false;
        });
        await HoleUpdate.InvokeAsync(new HoleUpdate
        {
            Golfers = Group.Golfers,
            CurrentHole = currentHole,
            GroupId = Group.Id,
            CompleteGame = false
        });
    }
}
