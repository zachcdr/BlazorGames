@using Quarantine.ExtensionMethods
@using Quarantine.Helpers
@using Quarantine.Models
@using Quarantine.Models.Enums

@if (Golfer != null)
{
    <span class="golf-label">Dots on this hole</span>
    <div class="golf-dot-grid">
        @foreach (DotType dot in DotTypes)
        {
            var isOn = currentHole.Dots.Contains(dot);
            <button type="button" class="golf-dot @(isOn ? "is-on" : "")" aria-pressed="@(isOn ? "true" : "false")"
                    @onclick="@(() => CheckboxClicked(dot))">
                <span class="golf-dot-icon">@GolfStyle.DotIcon(dot)</span>
                @dot.GetDescription()
            </button>
        }
    </div>
}

@code {
    [Parameter]
    public Golfer Golfer { get; set; }

    [Parameter]
    public List<DotType> DotTypes { get; set; }

    [Parameter]
    public int CurrentHole { get; set; }

    private Hole currentHole => Golfer?.Holes?.Single((Hole h) => h.Id == CurrentHole);

    private void CheckboxClicked(DotType dot)
    {
        if (currentHole.Dots.Contains(dot))
        {
            currentHole.Dots.Remove(dot);
        }
        else
        {
            currentHole.Dots.Add(dot);
        }
    }
}
