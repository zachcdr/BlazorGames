@using Quarantine.Models

@if (Cards != null && Cards.Count > 0)
{
    <div class="bar-cards @(Small ? "is-small" : "")">
        @for (var i = 0; i < Math.Min(4, Cards.Count); i++)
        {
            var card = Cards[i];
            @* Keyed by position (not card name, which can repeat in older games) plus face up/down,
               so the image re-mounts when it turns over and the flip animation replays. *@
            if (card.IsVisible)
            {
                <img @key="@($"{i}-up")" class="bar-card is-up" src="@("Images/" + card.FileName)" alt="@($"{card.Value} of {card.Suit}s")" />
            }
            else
            {
                <img @key="@($"{i}-down")" class="bar-card" src="Images/CardBackground.png" alt="Face-down card" />
            }
        }
    </div>
}

@code {
    [Parameter]
    public IList<Card> Cards { get; set; }

    [Parameter]
    public bool Small { get; set; }
}
