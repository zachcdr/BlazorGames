@using Quarantine.Helpers
@using Quarantine.Models
@using Quarantine.Models.Enums

@if (Group != null)
{
    currentHole = Group.CurrentHole;
    var holes = Group.Golfers.First().Holes;
    var isLastHole = currentHole >= holes.Last().Id;
    SelectedHole holeInfo = null;
    if (Group.CourseName != null)
    {
        Course course = CourseSelection.SelectCourse(Group.CourseName);
        if (course != null)
        {
            course.SelectTees(Group.CourseTeeBox);
            holeInfo = course.GetHole(currentHole);
        }
    }

    <div class="golf-hole-hero">
        <div class="golf-flag">@currentHole</div>
        <div>
            <div class="golf-hole-label">Now playing</div>
            <div class="golf-hole-title">Hole @currentHole</div>
        </div>
        @if (holeInfo != null)
        {
            <div class="golf-hole-stats">
                <div><b>@holeInfo.Par</b><span>Par</span></div>
                <div><b>@holeInfo.Yards</b><span>Yards</span></div>
                <div><b>@holeInfo.Handicap</b><span>Hcp</span></div>
            </div>
        }
    </div>

    <div class="golf-strip">
        @foreach (Hole h in holes)
        {
            var holeId = h.Id;
            var isPlayed = Group.Golfers.All(g => g.Holes.Single(x => x.Id == holeId).Score > 0);
            <button type="button" class="golf-pip @(holeId == currentHole ? "is-current" : isPlayed ? "is-played" : "")"
                    @onclick="@(() => GoToHole(holeId))">
                @holeId
            </button>
        }
    </div>

    <div class="golf-players">
        @foreach (Golfer golfer in Group.Golfers)
        {
            var hole = golfer.Holes.Single((Hole h) => h.Id == currentHole);
            var dotCount = hole.Dots.Count;
            <div class="golf-player @(golfer.IsVisible ? "is-open" : "")">
                <div class="golf-player-row">
                    <button type="button" class="golf-player-toggle" @onclick="@(() => Toggle(golfer.Id))">
                        <span class="golf-avatar">@GolfStyle.Initials(golfer.Name)</span>
                        <span class="golf-player-text">
                            <span class="golf-player-name">@golfer.Name</span>
                            <span class="golf-player-sub @(dotCount > 0 ? "has-dots" : "")">
                                @(dotCount == 0 ? "Tap to add dots" : dotCount == 1 ? "● 1 dot" : $"● {dotCount} dots")
                            </span>
                        </span>
                        <span class="golf-chevron">▾</span>
                    </button>
                    <input type="tel" class="golf-score-input" maxlength="2" placeholder="–" aria-label="@($"{golfer.Name} score")"
                           onClick="this.select();" value="@(hole.Score == 0 ? "" : hole.Score.ToString())"
                           @onchange="@(e => SetScore(hole, e))" />
                </div>
                @if (golfer.IsVisible)
                {
                    <div class="golf-player-dots">
                        <GolferView DotTypes="@AvailableDots" CurrentHole="@currentHole" Golfer="@golfer" />
                    </div>
                }
            </div>
        }
    </div>

    <div class="golf-nav">
        <button type="button" class="golf-btn golf-btn-ghost golf-btn-lg" disabled="@(currentHole <= holes.First().Id)" @onclick="Previous">‹ Prev</button>
        <button type="button" class="golf-btn golf-btn-primary golf-btn-lg" @onclick="Next">@(isLastHole ? "Finish Round 🏁" : "Next Hole ›")</button>
    </div>
}

@code {
    private int currentHole;

    [Parameter]
    public GolfGroup Group { get; set; }

    [Parameter]
    public List<DotType> AvailableDots { get; set; }

    [Parameter]
    public EventCallback<HoleUpdate> HoleUpdate { get; set; }

    private void SetScore(Hole hole, ChangeEventArgs e)
    {
        hole.Score = int.TryParse(e.Value?.ToString(), out var score) ? score : 0;
    }

    private async Task GoToHole(int holeId)
    {
        currentHole = holeId;
        await PerformUpdate();
    }

    private async Task Previous()
    {
        if (currentHole > Group.Golfers.First().Holes.First().Id)
        {
            currentHole--;
            await PerformUpdate();
        }
    }

    private async Task Next()
    {
        if (currentHole < Group.Golfers.First().Holes.Last().Id)
        {
            currentHole++;
            await PerformUpdate();
        }
        else
        {
            await PerformUpdate(gameOver: true);
        }
    }

    private void Toggle(int golferId)
    {
        if (Group.Golfers.Single((Golfer g) => g.Id == golferId).IsVisible)
        {
            Group.Golfers.Single((Golfer g) => g.Id == golferId).IsVisible = false;
            return;
        }
        Group.Golfers.ForEach(delegate(Golfer g)
        {
            g.IsVisible = false;
        });
        Group.Golfers.Single((Golfer g) => g.Id == golferId).IsVisible = true;
    }

    private async Task PerformUpdate(bool gameOver = false)
    {
        Group.Golfers.ForEach(delegate(Golfer g)
        {
            g.IsVisible = false;
        });
        await HoleUpdate.InvokeAsync(new HoleUpdate
        {
            Golfers = Group.Golfers,
            CurrentHole = currentHole,
            GroupId = Group.Id,
            CompleteGame = gameOver
        });
    }
}
