@using Quarantine.Helpers
@using Quarantine.Models
@using Quarantine.Models.Enums

@if (Group != null)
{
    var num = 0;
    <div class="golf-roster">
        @foreach (Golfer golfer in Group.Golfers)
        {
            num++;
            <div class="golf-roster-item">
                <span class="golf-avatar">@GolfStyle.Initials(golfer.Name)</span>
                @golfer.Name
                <span class="golf-roster-num">Player @num</span>
            </div>
        }
    </div>

    <EditForm Model="@NewPlayer" OnValidSubmit="SubmitPlayer">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <label class="golf-label" for="playerName">Add a player</label>
        <div class="golf-add">
            <InputText id="playerName" class="golf-input" placeholder="Name" @bind-Value="NewPlayer.Name" />
            <button class="golf-btn golf-btn-green" type="submit">＋ Add</button>
        </div>
    </EditForm>
}

@code {
    public Player NewPlayer = new Player();

    [Parameter]
    public GolfGroup Group { get; set; }

    [Parameter]
    public GolfRoundType GolfRoundType { get; set; }

    [Parameter]
    public NineType? NineType { get; set; }

    private void SubmitPlayer()
    {
        Group.AddPlayer(NewPlayer, GolfRoundType, NineType);
        NewPlayer = new Player();
    }
}
