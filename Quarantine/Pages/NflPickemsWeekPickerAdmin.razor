@page "/nfl-pickems/weeks/{weekId:int}/admin/{playerId:int}/picks"
@using Quarantine.Interfaces
@using Quarantine.Models.NflPickems
@using Quarantine.Helpers
@using System.Globalization
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@inject INflPlayerService PlayerService
@inject INflPickService PickService
@inject INflWinService WinService
@inject Quarantine.Services.NflCommissionerSession CommissionerSession

<div class="nfl">
    <div class="nfl-wrap">
        <a class="nfl-back" href="nfl-pickems/weeks/@WeekId">‹ Week @WeekId scoreboard</a>

        <header class="nfl-header">
            <div>
                <span class="nfl-eyebrow">Week @WeekId Picks · Admin</span>
                <h1 class="nfl-title">@(_player?.Name ?? "Loading…")</h1>
                <p class="nfl-sub">Tap the team you think will win each game. Picks lock Sunday at 10:00 AM PT, or at kickoff for earlier games.</p>
                @if (IsOverride)
                {
                    <span class="nfl-chip">⚡ Chap override · nothing is locked</span>
                }
            </div>
        </header>

        @if (_player == null)
        {
            for (var i = 0; i < 6; i++)
            {
                <div class="nfl-skeleton" style="height: 7rem;"></div>
            }
        }
        else
        {
            var count = _player.Picks.Count;
            var pickedCount = _picks.Count(p => _player.Picks.Any(g => g.GameId == p.GameId));
            var percent = count == 0 ? 0 : pickedCount * 100 / count;
            var weekTimes = _player.Picks.Select(p => p.GameTimeUtc).ToList();
            var editableCount = EditableGameIds().Count;
            var index = 0;

            <div class="nfl-progress"><div class="nfl-progress-bar" style="width: @(percent)%;"></div></div>

            foreach (var pick in _player.Picks.OrderBy(p => p.GameTimeUtc))
            {
                index++;
                var existingPick = _picks.SingleOrDefault(p => p.GameId == pick.GameId);
                var lockTimeUtc = NflPickLock.LockTimeUtc(pick.GameTimeUtc, weekTimes);
                var isLocked = !IsOverride && DateTime.UtcNow >= lockTimeUtc;
                var awayPicked = existingPick != null && existingPick.TeamId == pick.AwayTeam.Id;
                var homePicked = existingPick != null && existingPick.TeamId == pick.HomeTeam.Id;
                var anyPicked = awayPicked || homePicked;

                <div class="nfl-game">
                    <div class="nfl-game-meta">
                        <span>@NflTeamStyle.Kickoff(pick.GameTimeUtc)</span>
                        @if (isLocked && !NflPickLock.IsWeekScheduled(weekTimes))
                        {
                            <span class="nfl-lock">⏳ Not open yet</span>
                        }
                        else if (isLocked)
                        {
                            <span class="nfl-lock">🔒 Locked</span>
                        }
                        else if (DateTime.UtcNow >= lockTimeUtc)
                        {
                            <span class="nfl-override">Override</span>
                        }
                        else if (lockTimeUtc < pick.GameTimeUtc)
                        {
                            <span>Locks at @FormatPacific(lockTimeUtc)</span>
                        }
                        else
                        {
                            <span>Locks at @FormatPacific(pick.GameTimeUtc)</span>
                        }
                    </div>
                    <div class="nfl-matchup">
                        <button disabled="@isLocked" @onclick="@(() => AssignPick(pick.GameId, pick.AwayTeam.Id))"
                                style="@NflTeamStyle.CssVars(pick.AwayTeam.Name)"
                                class="nfl-team @(awayPicked ? "is-picked" : anyPicked ? "is-faded" : "")">
                            <NflTeamBadge Name="@pick.AwayTeam.Name" Large="true" />
                            <span class="nfl-team-text">
                                <span class="nfl-team-side">Away</span>
                                <span class="nfl-team-name">@pick.AwayTeam.Name</span>
                            </span>
                        </button>
                        <span class="nfl-at">@@</span>
                        <button disabled="@isLocked" @onclick="@(() => AssignPick(pick.GameId, pick.HomeTeam.Id))"
                                style="@NflTeamStyle.CssVars(pick.HomeTeam.Name)"
                                class="nfl-team is-home @(homePicked ? "is-picked" : anyPicked ? "is-faded" : "")">
                            <NflTeamBadge Name="@pick.HomeTeam.Name" Large="true" />
                            <span class="nfl-team-text">
                                <span class="nfl-team-side">Home</span>
                                <span class="nfl-team-name">@pick.HomeTeam.Name</span>
                            </span>
                        </button>
                    </div>
                </div>

                @if (index == count)
                {
                    <div class="nfl-tb-card">
                        <div>
                            <div class="nfl-tb-title">Tie Breaker</div>
                            <p class="nfl-tb-help">Total combined points in the last game (@pick.AwayTeam.Name @@ @pick.HomeTeam.Name).</p>
                        </div>
                        <input disabled="@isLocked" class="nfl-input" type="tel" maxlength="3"
                               onClick="this.select();" @bind="pick.TieBreaker" />
                    </div>
                }
            }

            <div class="nfl-savebar">
                <div class="nfl-savebar-inner">
                    <span class="nfl-savebar-status"><b>@pickedCount</b> / @count picked</span>
                    @if (editableCount == 0)
                    {
                        <button disabled class="nfl-btn nfl-btn-lg">@(NflPickLock.IsWeekScheduled(weekTimes) ? "🔒 Week locked" : "⏳ Not open yet")</button>
                    }
                    else if (!_isSaving)
                    {
                        <button @onclick="SavePicks" class="nfl-btn nfl-btn-primary nfl-btn-lg">Save Picks</button>
                    }
                    else
                    {
                        <button disabled class="nfl-btn nfl-btn-primary nfl-btn-lg"><span class="nfl-spinner"></span> Saving…</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _title;
    private PlayerPickView _player;
    private List<Pick> _picks;
    private bool _isSaving;

    private bool IsOverride => CommissionerSession.IsUnlocked;

    [Parameter]
    public int WeekId { get; set; }

    [Parameter]
    public int PlayerId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _title = $"Week {WeekId}";
        _player = (await WinService.GetPlayerPickViews(WeekId, PlayerId)).Single();
        _picks = (await PickService.GetPicks()).Where(p => p.PlayerId == PlayerId).ToList();
    }

    private static readonly TimeZoneInfo PacificZone = GetPacificZone();

    private static TimeZoneInfo GetPacificZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Los_Angeles");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Pacific Standard Time");
        }
    }

    private static string FormatPacific(DateTime utc)
    {
        var pacific = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc), PacificZone);

        return pacific.ToString("ddd h:mm tt", CultureInfo.InvariantCulture) + " PT";
    }

    // Present in the compiled code but never called from this page.
    private async Task CreatePassword()
    {
        var input = await jsRuntime.InvokeAsync<string>("passwordPrompt.showPrompt", "Please create a new password.");
        if (string.IsNullOrWhiteSpace(input))
        {
            NavigationManager.NavigateTo($"/nfl-pickems/weeks/{WeekId}");
        }
        else
        {
            await PlayerService.SavePlayerPassword(_player.Id, input);
        }
    }

    private void AssignPick(int gameId, int teamId)
    {
        if (!EditableGameIds().Contains(gameId))
        {
            return;
        }

        var gamePickView = _player.Picks.Single(p => p.GameId == gameId);
        var pick = _picks.SingleOrDefault(p => p.GameId == gameId);
        if (pick == null)
        {
            _picks.Add(new Pick
            {
                GameId = gameId,
                PlayerId = _player.Id,
                TeamId = teamId,
                TieBreaker = gamePickView.TieBreaker
            });
        }
        else
        {
            pick.TeamId = teamId;
            pick.TieBreaker = gamePickView.TieBreaker;
        }
    }

    private async Task SavePicks()
    {
        // The tie breaker is entered on the last game of the week; copy it onto that game's pick.
        var pickView = _player.Picks.SingleOrDefault(p => p.TieBreaker != 0);
        if (pickView != null)
        {
            var pick = _picks.SingleOrDefault(p => p.GameId == pickView.GameId);
            if (pick != null)
            {
                pick.TieBreaker = pickView.TieBreaker;
            }
        }
        _isSaving = true;
        // Locked games are never written, so a pick can't be added or changed after its lock time.
        var editableGameIds = EditableGameIds();
        await PickService.SavePicks(_picks.Where(p => editableGameIds.Contains(p.GameId)).ToList());
        CommissionerSession.IsUnlocked = false;
        NavigationManager.NavigateTo($"/nfl-pickems/weeks/{WeekId}");
    }

    private List<int> EditableGameIds()
    {
        var weekTimes = _player.Picks.Select(p => p.GameTimeUtc).ToList();
        return _player.Picks
            .Where(g => IsOverride || !NflPickLock.IsLocked(g.GameTimeUtc, weekTimes))
            .Select(g => g.GameId)
            .ToList();
    }
}
