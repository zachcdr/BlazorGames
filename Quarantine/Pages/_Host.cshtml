@page "/"
@namespace Quarantine.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

@* Rebuilt from the standard Blazor Server template: the original _Host.cshtml was compiled into
   Quarantine.Views.dll, which wasn't part of the recovery. If you recover that DLL, swap in the
   original so any extra <script>/<link> tags (e.g. charting libraries) come back too. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chap App</title>
    <base href="~/" />
    <link rel="icon" href="favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="css/nfl-pickems.css" rel="stylesheet" />
    <link href="css/dots.css" rel="stylesheet" />
    <link href="css/ridethebus.css" rel="stylesheet" />
    <link href="css/shell.css" rel="stylesheet" />
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="ServerPrerendered" />
    </app>

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    @* Fallbacks for the JS functions the app calls. Any real versions in your own wwwroot scripts take priority. *@
    <script src="js/recovered-stubs.js"></script>
</body>
</html>
