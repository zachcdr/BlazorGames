@page "/nfl-pickems/weeks/{weekId:int}/players/{playerId:int}/picks"
@inject NavigationManager NavigationManager

@* Picks are made on the week page now. This route stays so old links and bookmarks still land somewhere useful. *@

@code {
    [Parameter]
    public int WeekId { get; set; }

    [Parameter]
    public int PlayerId { get; set; }

    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo($"/nfl-pickems/weeks/{WeekId}");
    }
}
